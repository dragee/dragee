{
  "name": "dragee",
  "version": "1.3.1",
  "description": "Dragee(drag&drop) library",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "build-dev": "rollup --config rollup.dev.config.mjs",
    "eslint": "eslint .",
    "test": "NODE_ENV=test jest",
    "test-debug": "TZ=UTC NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-transform-for-of": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.20.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.34.8"
  },
  "repository": "github:dragee/dragee",
  "author": "Vitaliy Yarovuy, Volodymyr Myskov",
  "license": "ISC",
  "main": "dist/index.umd.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.esm.js",
    "dist/index.min.js",
    "dist/index.umd.js",
    "CHANGELOG.md"
  ],
  "homepage": "https://dragee.github.io/",
  "bugs": "https://github.com/dragee/dragee/issues",
  "keywords": [
    "drag",
    "drag&drop",
    "draggable",
    "restrict-movements"
  ],
  "sideEffects": false
}
